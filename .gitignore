# Source material dropped in the repo root while editing copy. The event brief
# is an email thread with a prospective sponsor's address in it — keep it out
# of a public repo.
*.eml

.DS_Store
node_modules/

# Local wrangler dev state (miniflare caches, sqlite) — regenerated on demand.
.wrangler/

# Scratch files that live in the repo root while working. NSDS_VibesVid.mp4 is
# 160MB — over GitHub's hard 100MB per-file limit, so committing it would fail
# the push outright.
/NSDS_VibesVid.mp4
/probe*.html

# Full-resolution source art and photos, dropped in the root on the way to
# media/sponsors/ or media/opt/. Nothing here is served — the repo keeps only
# what the pages actually load, and Drive holds the originals.
/*.png
/*.jpg
/*.jpeg
/*.mp4
