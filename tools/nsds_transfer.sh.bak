#!/bin/bash
# NSDS: Dropbox -> local staging -> Google Drive, unattended.
#
#   ./nsds_transfer.sh              # fetch everything, then upload
#   ./nsds_transfer.sh --fetch-only
#   ./nsds_transfer.sh --upload-only
#
# Safe to re-run at any point: the fetch skips completed files and resumes
# partials, and rclone skips objects already on Drive at the same size.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STAGING="${NSDS_STAGING:-$HOME/NSDS-transfer-staging}"
LOGDIR="$STAGING/logs"
REMOTE="${NSDS_RCLONE_REMOTE:-nsdsdrive}"
RCLONE="${RCLONE:-/opt/homebrew/bin/rclone}"

# Destination Drive folder IDs. Created ahead of time precisely because these
# folder names contain "/" — legal in Drive, not in a path, so we never let
# rclone resolve them by name.
DEST_APRIL="1bS6gBq5vcLFbbGNG-_qB-9yWuknChO6Y"   # April 2026 Tapes/Photos (existing)
DEST_MAY="1J9A7CLVdD8tNsQwhBq2jSHSWP75zLsOg"     # May 2026 Tapes/Photos (Boston)
DEST_JULY="1jLpdaNRmhIFldwzf9fBnRBiw8lnDt2Vl"    # July 2026 Tapes/Photos (NYC)

DO_FETCH=1; DO_UPLOAD=1
for a in "$@"; do
  case "$a" in
    --fetch-only)  DO_UPLOAD=0 ;;
    --upload-only) DO_FETCH=0 ;;
    -h|--help) sed -n '2,12p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown flag: $a" >&2; exit 2 ;;
  esac
done

mkdir -p "$LOGDIR"
say() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

say "=== NSDS transfer starting (staging: $STAGING) ==="

# --- preflight ---------------------------------------------------------------
if [ "$DO_UPLOAD" -eq 1 ]; then
  command -v "$RCLONE" >/dev/null || { say "FATAL: rclone not found at $RCLONE"; exit 3; }
  if ! "$RCLONE" listremotes | grep -qx "${REMOTE}:"; then
    say "FATAL: rclone remote '${REMOTE}:' is not configured."
    say "  Run:  rclone config create $REMOTE drive scope=drive"
    say "  It opens a browser once; sign in as the account that should OWN the uploads."
    exit 3
  fi
  # Fail before a 108 GiB transfer rather than halfway through it.
  say "checking Drive quota on '${REMOTE}:' ..."
  if quota="$("$RCLONE" about "${REMOTE}:" 2>/dev/null)"; then
    printf '%s\n' "$quota" | sed 's/^/    /'
    free_b="$("$RCLONE" about "${REMOTE}:" --json 2>/dev/null | /usr/bin/python3 -c \
      'import json,sys; print(json.load(sys.stdin).get("free",-1))' 2>/dev/null || echo -1)"
    need_b=125000000000   # ~116 GiB with headroom
    if [ "$free_b" -ge 0 ] && [ "$free_b" -lt "$need_b" ]; then
      say "FATAL: only $((free_b/1000000000)) GB free on the Drive account; need ~125 GB."
      say "  Either free space, upgrade Google One, or point NSDS_RCLONE_REMOTE at another account."
      exit 4
    fi
  else
    say "  (quota unavailable — continuing, but watch for a quota error mid-upload)"
  fi
fi

# --- fetch -------------------------------------------------------------------
if [ "$DO_FETCH" -eq 1 ]; then
  say "--- fetching from Dropbox ---"
  /usr/bin/python3 "$HERE/nsds_fetch.py" --jobs 3 2>&1 | tee -a "$LOGDIR/fetch.log"
  rc=${PIPESTATUS[0]}
  if [ "$rc" -ne 0 ]; then
    say "fetch exited $rc — NOT uploading a partial set. Re-run to resume."
    exit "$rc"
  fi
fi

# --- upload ------------------------------------------------------------------
upload() {
  # Separate statements on purpose: macOS ships bash 3.2, which expands every
  # argument of `local` before performing any of the assignments, so a single
  # `local a="$1" b="$a"` makes $b unbound under `set -u`. Bash 5 does not.
  local show="$1"
  local folder_id="$2"
  local src="$STAGING/$show"
  [ -d "$src" ] || { say "  no staging dir for '$show', skipping"; return 0; }
  say "uploading '$show' -> folder $folder_id"
  "$RCLONE" copy "$src" "${REMOTE},root_folder_id=${folder_id}:" \
    --transfers 4 \
    --checkers 8 \
    --drive-chunk-size 128M \
    --drive-acknowledge-abuse \
    --drive-stop-on-upload-limit \
    --retries 10 \
    --low-level-retries 20 \
    --timeout 5m \
    --size-only \
    --stats 60s \
    --stats-one-line \
    --log-file "$LOGDIR/upload-$show.log" \
    --log-level INFO
  say "  '$show' upload finished; verifying"
  "$RCLONE" check "$src" "${REMOTE},root_folder_id=${folder_id}:" \
    --size-only --one-way --log-file "$LOGDIR/verify-$show.log" --log-level INFO \
    && say "  '$show' VERIFIED" \
    || { say "  '$show' VERIFY FAILED — see $LOGDIR/verify-$show.log"; return 1; }
}

if [ "$DO_UPLOAD" -eq 1 ]; then
  say "--- uploading to Google Drive ---"
  fail=0
  upload "April 2026 NYC"  "$DEST_APRIL" || fail=1
  upload "May 2026 Boston" "$DEST_MAY"   || fail=1
  upload "July 2026 NYC"   "$DEST_JULY"  || fail=1
  [ "$fail" -eq 0 ] || { say "one or more uploads failed; re-run to retry"; exit 5; }
fi

say "=== NSDS transfer COMPLETE ==="
say "Staging kept at $STAGING — delete it yourself once you've spot-checked Drive:"
say "    rm -rf \"$STAGING\""
